# hexawyn — environment configuration template
# Copy to .env and fill in your own values. Never commit real secrets.

# ── Kubernetes ─────────────────────────────────────────────
# Default: ~/.kube/config (or set KUBECONFIG to a colon-separated file list)

# ── Runtime (hexa-control-plane) ──────────────────────────
HEXAWYN_RUNTIME_ENDPOINT=

# ── Licensing / auth ──────────────────────────────────────
HEXAWYN_LICENSE_KEY=
HEXAWYN_TOKEN=

# ── Cloud / telemetry ─────────────────────────────────────
HEXAWYN_CLOUD_ENDPOINT=
HEXAWYN_TELEMETRY=

# ── Demo mode (dev only) ──────────────────────────────────
# HEXAWYN_DEMO_MODE=true
# HEXAWYN_DEMO_SCENARIO=aws_eks

# ── Slack alerts ──────────────────────────────────────────
HEXAWYN_SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ── MCP server ────────────────────────────────────────────
# HEXAWYN_PORT=8000

# ── DuckDB encryption (default: enabled) ──────────────────
# Set to "true" to disable encryption of the local DuckDB at rest.
# HEXAWYN_DISABLE_ENCRYPTION=true

# ── Package update check ──────────────────────────────────
# Index used by `hexa update` to compare the installed version with the
# latest published one. Resolution order:
#   1. HEXAWYN_PYPI_INDEX_URL env var (explicit override)
#   2. persisted pypi_index_url in ~/.hexawyn/config.yaml
#   3. auto-detection: https://pypi.org (prod), falling back to
#      https://test.pypi.org when the package is missing there
# Default (production): no variable needed. Point at TestPyPI to force the
# dev index, or let the auto-detection discover it on first `hexa update`:
# HEXAWYN_PYPI_INDEX_URL=https://test.pypi.org
# HEXAWYN_PYPI_INDEX_URL=https://pypi.org

# ── Misc ──────────────────────────────────────────────────
# HEXAWYN_ANONYMIZE_ENABLED=true
# HEXAWYN_SCHEDULER_ENABLED=true
PYTHONPATH=src
